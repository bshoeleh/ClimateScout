<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @{
        // Search and share-preview tags. A view may set ViewData["Description"] and ViewData["Image"] (an app path such as ~/img/...).
        var origin = $"{Context.Request.Scheme}://{Context.Request.Host}";
        var pageUrl = origin + Context.Request.PathBase + Context.Request.Path;   // no query string: one address per page
        var pageTitle = ViewData["Title"] is string title ? $"{title} · Arcadis ClimateScout®" : "Arcadis ClimateScout®";
        var description = ViewData["Description"] as string
            ?? "Climate-responsive design strategies for every Köppen climate zone, and the carbon intensity of electricity around the world.";
        var image = origin + Url.Content(ViewData["Image"] as string ?? "~/img/brand/logo-on-light.png");
    }
    <title>@pageTitle</title>
    <meta name="description" content="@description" />
    @if (Context.Response.StatusCode < 400)
    {
        <link rel="canonical" href="@pageUrl" />
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Arcadis ClimateScout®" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@description" />
    @if (Context.Response.StatusCode < 400)
    {
        <meta property="og:url" content="@pageUrl" />
    }
    <meta property="og:image" content="@image" />
    <partial name="_HeadAssets" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        // Public menu. Paths match the old site's URLs (plan §4); pages not built yet show the 404 page.
        // Sections: other paths that belong to the item, so it stays highlighted on those pages.
        var navItems = new (string Text, string Path, string[] Sections)[]
        {
            ("Climate Zones", "/", ["/zone", "/design-strategy"]),
            ("Carbon", "/carbon", ["/carbon-comparison"]),
            ("Sponsors", "/sponsors", []),
            ("About", "/about", []),
            ("Contact", "/contact", []),
        };
        var currentPath = Context.Request.Path.Value?.TrimEnd('/') is { Length: > 0 } path ? path : "/";

        bool IsCurrent(string itemPath, string[] sections) =>
            string.Equals(currentPath, itemPath, StringComparison.OrdinalIgnoreCase)
            || sections.Any(s => string.Equals(currentPath, s, StringComparison.OrdinalIgnoreCase)
                                 || currentPath.StartsWith(s + "/", StringComparison.OrdinalIgnoreCase));
    }
    <partial name="_IconSprite" />
    @* Hidden until it gets keyboard focus: lets keyboard users jump past the menu. *@
    <a class="visually-hidden-focusable cs-skip-link" href="#content">Skip to content</a>
    <header>
        <nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom box-shadow mb-4" aria-label="Main">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/img/brand/logo-on-light.png" class="cs-logo cs-logo-on-light" width="329" height="23" alt="Arcadis ClimateScout®" />
                    <img src="~/img/brand/logo-on-dark.png" class="cs-logo cs-logo-on-dark" width="332" height="23" alt="Arcadis ClimateScout®" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-nav"
                        aria-controls="main-nav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="main-nav">
                    <ul class="navbar-nav me-auto ms-lg-4">
                        @foreach (var item in navItems)
                        {
                            var current = IsCurrent(item.Path, item.Sections);
                            <li class="nav-item">
                                <a class="nav-link @(current ? "active" : null)" href="@Url.Content("~" + item.Path)"
                                   aria-current="@(current ? "page" : null)">@item.Text</a>
                            </li>
                        }
                    </ul>
                    <partial name="_ThemeMenu" />
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" id="content" tabindex="-1" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top bg-body-tertiary text-body-secondary small mt-5 py-4">
        <div class="container">
            <vc:sponsor-strip />
            <div class="d-flex flex-column flex-md-row justify-content-between gap-2">
                <div>&copy; @DateTime.UtcNow.Year Arcadis</div>
                <ul class="list-inline mb-0">
                    <li class="list-inline-item"><a href="~/contact">Contact</a></li>
                    <li class="list-inline-item"><a href="https://www.arcadis.com/en/privacy">Privacy</a></li>
                    <li class="list-inline-item"><a href="https://www.arcadis.com/">Arcadis.com</a></li>
                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <li class="list-inline-item"><a asp-area="Identity" asp-page="/Account/Login">Staff sign-in</a></li>
                    }
                </ul>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
