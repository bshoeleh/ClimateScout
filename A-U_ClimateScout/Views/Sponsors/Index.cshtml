@model IReadOnlyList<A_U_ClimateScout.Models.Sponsor>
@{
    ViewData["Title"] = "Sponsors";
}

<div class="container py-4 py-lg-5">
    <h1>Sponsors</h1>
    <p class="lead col-lg-8">
        Arcadis ClimateScout® is free for everyone. Our sponsors help keep it that way and support climate-responsive design.
    </p>

    @if (Model.Count > 0)
    {
        <div class="row g-4 mt-2">
            @foreach (var sponsor in Model)
            {
                <div class="@(sponsor.Tier == 1 ? "col-md-6" : "col-md-6 col-lg-4")">
                    <article class="cs-sponsor-card">
                        @if (sponsor.LogoAsset is not null)
                        {
                            <img class="cs-sponsor-logo" src="~/img/media/@sponsor.LogoAsset.StoragePath" alt="@sponsor.Name" />
                        }
                        <h2 class="h5 mt-3">
                            @if (string.IsNullOrEmpty(sponsor.Url))
                            {
                                @sponsor.Name
                            }
                            else
                            {
                                <a href="@sponsor.Url" rel="noopener">@sponsor.Name</a>
                            }
                        </h2>
                        @Html.Raw(sponsor.DescriptionHtml)
                    </article>
                </div>
            }
        </div>
    }

    <section class="cs-sponsor-invite mt-5">
        <h2 class="h4">@(Model.Count > 0 ? "Become a sponsor" : "Be our first sponsor")</h2>
        <p class="mb-3">
            Sponsors are recognised on this page and in the footer of every page. If your organisation would like to
            support ClimateScout, we'd love to hear from you.
        </p>
        <a class="btn btn-primary" href="~/contact?about=sponsoring">Contact us about sponsoring</a>
    </section>
</div>
