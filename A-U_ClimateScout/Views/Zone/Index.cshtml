@using A_U_ClimateScout.Controllers
@model A_U_ClimateScout.Models.ZonePageViewModel
@{
    var zone = Model.Zone;
    ViewData["Title"] = $"{zone.KoppenCode} {zone.Name}";
}

@section Styles {
    @* Zone colours come from the database (ZoneController.Stylesheet). *@
    <link rel="stylesheet" href="~/css/zones.css" />
}

<div class="container py-4 py-lg-5">
    <span class="cs-zone-label @ZoneController.CssClass(zone.KoppenCode)">
        Climate zone · @zone.Group.Name
    </span>
    <h1 class="mt-3"><span class="text-body-secondary">@zone.KoppenCode</span> @zone.Name</h1>
    <div class="col-lg-8">
        @Html.Raw(zone.DescriptionHtml)
    </div>
</div>

@if (Model.DiagramMarkup is not null)
{
    <section class="cs-diagram" aria-label="Building diagram">
        <div class="container">
            <p class="cs-diagram-help" data-diagram-help>
                Begin by selecting <svg class="cs-icon" aria-hidden="true"><use href="#cs-icon-plus"></use></svg> design strategies below.
            </p>
            @Html.Raw(Model.DiagramMarkup)
        </div>
    </section>
}

<section class="container py-4 pb-5" aria-labelledby="strategies-heading">
    <h2 id="strategies-heading" class="h5 text-uppercase">Design strategies for @zone.Name</h2>
    <div class="row g-3 mt-1">
        @foreach (var strategy in zone.Strategies.Select(l => l.Strategy))
        {
            <div class="col-sm-6 col-lg-4 col-xl-3">
                <div class="cs-strategy-card" data-strategy="@strategy.Slug" data-conflicts="@string.Join(",", Model.ConflictsBySlug[strategy.Slug])">
                    <a class="cs-strategy-link" href="~/design-strategy/@strategy.Slug">
                        @if (strategy.ImageAsset is not null)
                        {
                            <img src="~/img/media/@strategy.ImageAsset.StoragePath" alt="" width="64" height="64" loading="lazy" />
                        }
                        <span class="cs-strategy-name">@strategy.Name</span>
                    </a>
                    @if (Model.DiagramLayers.Contains(strategy.Slug))
                    {
                        <button type="button" class="cs-strategy-toggle" aria-pressed="false" aria-label="Show @strategy.Name on the diagram">
                            <svg class="cs-icon cs-icon-off" aria-hidden="true"><use href="#cs-icon-plus"></use></svg>
                            <svg class="cs-icon cs-icon-on" aria-hidden="true"><use href="#cs-icon-minus"></use></svg>
                        </button>
                    }
                    <p class="cs-strategy-conflict" data-conflict-note hidden></p>
                    <p class="cs-strategy-print-summary">@strategy.Summary</p>
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script type="module" src="~/js/zone-diagram.js" asp-append-version="true"></script>
}
