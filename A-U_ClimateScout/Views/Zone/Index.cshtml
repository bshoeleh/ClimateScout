@using A_U_ClimateScout.Controllers
@model A_U_ClimateScout.Models.ClimateZone
@{
    ViewData["Title"] = $"{Model.KoppenCode} {Model.Name}";
}

@section Styles {
    @* Zone colours come from the database (ZoneController.Stylesheet). *@
    <link rel="stylesheet" href="~/css/zones.css" />
}

<div class="container py-4 py-lg-5">
    <span class="cs-zone-label @ZoneController.CssClass(Model.KoppenCode)">
        Climate zone · @Model.Group.Name
    </span>
    <h1 class="mt-3"><span class="text-body-secondary">@Model.KoppenCode</span> @Model.Name</h1>
    <div class="col-lg-8">
        @Html.Raw(Model.DescriptionHtml)
    </div>
</div>

<section class="container pb-5" aria-labelledby="strategies-heading">
    <h2 id="strategies-heading" class="h5 text-uppercase">Design strategies for @Model.Name</h2>
    <div class="row g-3 mt-1">
        @foreach (var strategy in Model.Strategies.Select(l => l.Strategy))
        {
            <div class="col-sm-6 col-lg-4 col-xl-3">
                <a class="cs-strategy-card" href="~/design-strategy/@strategy.Slug">
                    @if (strategy.ImageAsset is not null)
                    {
                        <img src="~/img/media/@strategy.ImageAsset.StoragePath" alt="" width="64" height="64" loading="lazy" />
                    }
                    <span>@strategy.Name</span>
                </a>
            </div>
        }
    </div>
</section>
