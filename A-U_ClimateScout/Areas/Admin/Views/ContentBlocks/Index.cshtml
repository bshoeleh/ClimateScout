@using A_U_ClimateScout.Areas.Admin.Controllers
@model List<ContentBlock>
@{
    ViewData["Title"] = "Content blocks";
}

<h1 class="h3 mb-2">Content blocks</h1>
<p class="text-body-secondary mb-4">Editable texts on the public pages. Each block belongs to a fixed place on a page, so blocks can be edited but not added or removed here.</p>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th scope="col">Block</th>
                <th scope="col">Starts with</th>
                <th scope="col">Last changed</th>
                <th scope="col"><span class="visually-hidden">On the site</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var block in Model)
            {
                var page = ContentBlocksController.PagePath(block.Key);
                <tr>
                    <td>
                        <a asp-action="Edit" asp-route-key="@block.Key">@block.Title</a>
                        <div class="small text-body-secondary"><code>@block.Key</code></div>
                    </td>
                    <td class="small">
                        @(PlainText.Summarize(block.Html, 90) ?? "")
                        @if (string.IsNullOrWhiteSpace(block.Html))
                        {
                            <span class="text-body-secondary fst-italic">Empty (nothing shows on the page)</span>
                        }
                    </td>
                    <td class="small text-nowrap">
                        @if (block.UpdatedBy is not null)
                        {
                            <span>@block.UpdatedAt.ToLocalTime().ToString("d MMM yyyy")<br /><span class="text-body-secondary">@block.UpdatedBy.UserName</span></span>
                        }
                        else
                        {
                            <span class="text-body-secondary">Imported</span>
                        }
                    </td>
                    <td class="small text-nowrap">
                        @if (page is not null)
                        {
                            <a href="@Url.Content("~" + page)" target="_blank" rel="noopener">View on site</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
