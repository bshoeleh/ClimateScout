@using A_U_ClimateScout.Areas.Admin.Controllers
@using A_U_ClimateScout.Services
@model CarbonRegionsController.RegionForm
@{
    var region = (CarbonRegion)ViewData["Region"]!;
    var sources = (List<CarbonDataSource>)ViewData["Sources"]!;
    var history = (List<CarbonIntensity>)ViewData["Values"]!;
    var current = (CurrentCarbonValue?)ViewData["Current"];
    ViewData["Title"] = region.Name;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Carbon regions</a></li>
        <li class="breadcrumb-item active" aria-current="page">@region.Name</li>
    </ol>
</nav>

<div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-1">
    <h1 class="h3 mb-0">@region.Name</h1>
    <a href="~/carbon-comparison?region=@region.Code" target="_blank" rel="noopener">View on site</a>
</div>
<p class="text-body-secondary">
    <code>@region.Code</code> · @region.RegionType@(region.ParentRegion is null ? "" : $" in {region.ParentRegion.Name}") ·
    current value @(current is null ? "none" : $"{current.ValueGPerKWh:N1} g CO₂/kWh ({current.Year}, {current.Source})")
</p>
<partial name="_Status" />

<div class="row g-5">
    <div class="col-xl-6">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input asp-for="Id" type="hidden" />
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" required />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Continent" class="form-label"></label>
                <input asp-for="Continent" class="form-control" />
                <div class="form-text">Used to group countries in the comparison chart.</div>
            </div>
            <div class="mb-3">
                <label asp-for="PreferredSourceId" class="form-label"></label>
                <select asp-for="PreferredSourceId" class="form-select">
                    <option value="">Any (latest year wins)</option>
                    @foreach (var source in sources)
                    {
                        <option value="@source.Id">@source.Name</option>
                    }
                </select>
                <div class="form-text">When several sources have figures for this region, the latest year from this source is the one shown.</div>
            </div>
            <div class="form-check mb-3">
                <input asp-for="ShowOnMap" class="form-check-input" />
                <label asp-for="ShowOnMap" class="form-check-label"></label>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
        </form>
    </div>

    <div class="col-xl-6">
        <h2 class="h6 text-uppercase">Aliases</h2>
        @if (region.Aliases.Count == 0)
        {
            <p class="small text-body-secondary">None: files must use the name or code above.</p>
        }
        else
        {
            <ul class="list-group list-group-flush mb-3">
                @foreach (var alias in region.Aliases.OrderBy(a => a.Alias))
                {
                    <li class="list-group-item d-flex align-items-center justify-content-between px-0">
                        <span>@alias.Alias <span class="small text-body-secondary">@alias.Source</span></span>
                        <form asp-action="DeleteAlias" asp-route-id="@region.Id" asp-route-aliasId="@alias.Id" method="post">
                            <button type="submit" class="btn btn-sm btn-link text-danger" aria-label="Remove alias @alias.Alias">Remove</button>
                        </form>
                    </li>
                }
            </ul>
        }
        <form asp-action="AddAlias" asp-route-id="@region.Id" method="post" class="d-flex gap-2">
            <label for="alias" class="visually-hidden">Another name</label>
            <input id="alias" name="alias" class="form-control form-control-sm" placeholder="Another name, e.g. Viet Nam" />
            <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">Add alias</button>
        </form>

        <h2 class="h6 text-uppercase mt-5">Imported values</h2>
        @if (history.Count == 0)
        {
            <p class="small text-body-secondary">No values imported yet.</p>
        }
        else
        {
            <table class="table table-sm small">
                <thead><tr><th scope="col">Year</th><th scope="col">Source</th><th scope="col" class="text-end">g CO₂/kWh</th><th scope="col">Import</th></tr></thead>
                <tbody>
                    @foreach (var value in history)
                    {
                        <tr class="@(value.SupersededByBatchId is null ? null : "text-body-secondary text-decoration-line-through")">
                            <td>@value.Year</td>
                            <td>@value.Source.Name</td>
                            <td class="text-end">@value.ValueGPerKWh.ToString("N1")</td>
                            <td>#@value.ImportBatchId@(value.SupersededByBatchId is { } by ? $" (replaced by #{by})" : "")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
