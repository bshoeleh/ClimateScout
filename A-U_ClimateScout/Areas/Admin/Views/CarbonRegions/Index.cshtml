@using A_U_ClimateScout.Services
@model List<CarbonRegion>
@{
    ViewData["Title"] = "Carbon regions";
    var current = (IReadOnlyDictionary<int, CurrentCarbonValue>)ViewData["Current"]!;
    var type = (CarbonRegionType?)ViewData["Type"];
}

<h1 class="h3 mb-2">Carbon regions</h1>
<p class="text-body-secondary mb-3">Countries, US states, Canadian provinces and aggregates. Aliases are the other names a data file may use for a region; the carbon importer matches on them.</p>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-sm-6 col-lg-4">
        <label for="search" class="form-label small">Name, code or alias</label>
        <input id="search" name="search" value="@ViewData["Search"]" class="form-control form-control-sm" />
    </div>
    <div class="col-sm-4 col-lg-3">
        <label for="type" class="form-label small">Type</label>
        <select id="type" name="type" class="form-select form-select-sm">
            <option value="">All</option>
            @foreach (var value in Enum.GetValues<CarbonRegionType>())
            {
                <option value="@value" selected="@(value == type)">@value</option>
            }
        </select>
    </div>
    <div class="col-sm-2 col-lg-2"><button type="submit" class="btn btn-sm btn-primary">Filter</button></div>
</form>

<p class="small text-body-secondary">@Model.Count regions</p>
<div class="table-responsive">
    <table class="table table-sm table-hover align-middle small">
        <thead>
            <tr><th scope="col">Region</th><th scope="col">Code</th><th scope="col">Type</th><th scope="col" class="text-end">Current g CO₂/kWh</th><th scope="col">Aliases</th><th scope="col">Map</th></tr>
        </thead>
        <tbody>
            @foreach (var region in Model)
            {
                var value = current.GetValueOrDefault(region.Id);
                <tr>
                    <td><a asp-action="Edit" asp-route-id="@region.Id">@region.Name</a></td>
                    <td><code>@region.Code</code></td>
                    <td>@region.RegionType</td>
                    <td class="text-end">@(value is null ? "—" : $"{value.ValueGPerKWh:N0} ({value.Year})")</td>
                    <td>@region.Aliases.Count</td>
                    <td>@(region.ShowOnMap ? "Yes" : "No")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
