@using A_U_ClimateScout.Areas.Admin.Controllers
@model EquivalencyFactorsController.FactorForm
@{
    ViewData["Title"] = Model.Label;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Equivalency factors</a></li>
        <li class="breadcrumb-item active" aria-current="page"><code>@Model.Key</code></li>
    </ol>
</nav>

<h1 class="h4 mb-4">@Model.Label</h1>

<form asp-action="Edit" method="post" style="max-width: 44rem">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <input asp-for="Key" type="hidden" />
    <div class="row g-3">
        <div class="col-12">
            <label asp-for="Label" class="form-label"></label>
            <input asp-for="Label" class="form-control" required />
            <div class="form-text">Follows the number in the infographic: "1,234 <em>gallons of gasoline consumed</em>".</div>
            <span asp-validation-for="Label" class="text-danger small"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="TonsCo2ePerUnit" class="form-label"></label>
            <input asp-for="TonsCo2ePerUnit" class="form-control font-monospace" type="number" step="any" min="0" required />
            <span asp-validation-for="TonsCo2ePerUnit" class="text-danger small"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="SortOrder" class="form-label"></label>
            <input asp-for="SortOrder" class="form-control" type="number" />
        </div>
        <div class="col-sm-6">
            <label asp-for="UnitSingular" class="form-label"></label>
            <input asp-for="UnitSingular" class="form-control" required />
            <span asp-validation-for="UnitSingular" class="text-danger small"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="UnitPlural" class="form-label"></label>
            <input asp-for="UnitPlural" class="form-control" required />
            <div class="form-text">For the scale note under the icons: "each icon = 200 gallons".</div>
            <span asp-validation-for="UnitPlural" class="text-danger small"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="Kind" class="form-label">Group</label>
            <select asp-for="Kind" class="form-select">
                <option value="@EquivalencyKind.Emissions">The same as (emissions)</option>
                <option value="@EquivalencyKind.Absorption">To absorb it (nature)</option>
            </select>
        </div>
        <div class="col-sm-6">
            <label asp-for="Icon" class="form-label"></label>
            <select asp-for="Icon" class="form-select">
                @foreach (var icon in EquivalencyFactorsController.Icons)
                {
                    <option value="@icon">@icon</option>
                }
            </select>
            <span asp-validation-for="Icon" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label asp-for="SourceUrl" class="form-label"></label>
            <input asp-for="SourceUrl" class="form-control" type="url" />
            <span asp-validation-for="SourceUrl" class="text-danger small"></span>
        </div>
    </div>
    <div class="d-flex align-items-center gap-3 mt-4">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index">Cancel</a>
    </div>
</form>
