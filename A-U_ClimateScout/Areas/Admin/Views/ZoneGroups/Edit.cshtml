@model A_U_ClimateScout.Areas.Admin.Models.ZoneGroupForm
@{
    ViewData["Title"] = Model.Name;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Zone groups</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<h1 class="h3 mb-4">@Model.Code · @Model.Name</h1>

<form asp-action="Edit" method="post" class="cs-admin-form" style="max-width: 36rem">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <input asp-for="Id" type="hidden" />
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" required />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Color" class="form-label"></label>
        <div class="input-group" style="max-width: 16rem">
            <input type="color" class="form-control form-control-color" value="@Model.Color" aria-label="Pick the colour" data-color-picker />
            <input asp-for="Color" class="form-control" data-color-text />
        </div>
        <span asp-validation-for="Color" class="text-danger small"></span>
    </div>
    <div class="d-flex align-items-center gap-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <script src="~/js/admin-color.js" asp-append-version="true"></script>
}
