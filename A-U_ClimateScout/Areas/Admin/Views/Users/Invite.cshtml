@using A_U_ClimateScout.Areas.Admin.Controllers
@model UsersController.InviteForm
@{
    ViewData["Title"] = "Invite someone";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Users</a></li>
        <li class="breadcrumb-item active" aria-current="page">Invite</li>
    </ol>
</nav>

<h1 class="h3 mb-3">Invite someone</h1>
<p class="text-body-secondary">They get a one-time password (shown on the next page, and emailed once email is set up) and choose their own at first sign-in.</p>

<form asp-action="Invite" method="post" style="max-width: 32rem">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email address</label>
        <input asp-for="Email" class="form-control" type="email" required />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Role" class="form-label"></label>
        <select asp-for="Role" class="form-select">
            @foreach (var role in UsersController.AssignableRoles)
            {
                <option value="@role">@role</option>
            }
        </select>
        <span asp-validation-for="Role" class="text-danger small"></span>
    </div>
    <div class="d-flex align-items-center gap-3">
        <button type="submit" class="btn btn-primary">Create the account</button>
        <a asp-action="Index">Cancel</a>
    </div>
</form>
