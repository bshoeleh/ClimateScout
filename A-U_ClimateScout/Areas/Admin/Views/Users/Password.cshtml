@inject A_U_ClimateScout.Services.IEmailService Email
@{
    ViewData["Title"] = "One-time password";
}

<h1 class="h3 mb-3">One-time password</h1>
<div class="alert alert-warning" role="status" style="max-width: 40rem">
    <p class="mb-2">For <strong>@TempData["PasswordFor"]</strong>:</p>
    <p class="fs-5 mb-2"><code class="user-select-all">@TempData["Password"]</code></p>
    <p class="small mb-0">
        It is shown only this once. @(Email.IsConfigured ? "It has also been emailed to them." : "Email isn't set up yet, so pass it on yourself (by phone or Teams, not in the same email as the address).")
        They must choose their own password at first sign-in.
    </p>
</div>
<a asp-action="Index">Back to Users</a>
